APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-this-admin-password

DB_NAME=tte
DB_USER=tte
DB_PASSWORD=change-this-db-password
DB_URL=jdbc:postgresql://postgres:5432/tte

PKI_BASE_DIR=/app/data/pki
PKI_PUBLIC_BASE_URL=http://localhost:8080
